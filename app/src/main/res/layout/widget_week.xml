<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">
    <TextView android:fontFamily="@font/inter_widget" android:id="@+id/week_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/widget_accent" android:maxLines="1" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
        <TextView android:fontFamily="@font/inter_widget" android:id="@+id/week_dow_0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:textColor="@color/widget_dim" />
        <TextView android:fontFamily="@font/inter_widget" android:id="@+id/week_dow_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:textColor="@color/widget_dim" />
        <TextView android:fontFamily="@font/inter_widget" android:id="@+id/week_dow_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:textColor="@color/widget_dim" />
        <TextView android:fontFamily="@font/inter_widget" android:id="@+id/week_dow_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:textColor="@color/widget_dim" />
        <TextView android:fontFamily="@font/inter_widget" android:id="@+id/week_dow_4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:textColor="@color/widget_dim" />
        <TextView android:fontFamily="@font/inter_widget" android:id="@+id/week_dow_5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:textColor="@color/widget_dim" />
        <TextView android:fontFamily="@font/inter_widget" android:id="@+id/week_dow_6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:textColor="@color/widget_dim" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <LinearLayout android:id="@+id/week_cell_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:fontFamily="@font/inter_widget" android:id="@+id/week_day_0" android:layout_width="26dp" android:layout_height="26dp" android:gravity="center" android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="1" />
            <TextView android:fontFamily="@font/inter_widget" android:id="@+id/week_dots_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="8sp" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/week_cell_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:fontFamily="@font/inter_widget" android:id="@+id/week_day_1" android:layout_width="26dp" android:layout_height="26dp" android:gravity="center" android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="1" />
            <TextView android:fontFamily="@font/inter_widget" android:id="@+id/week_dots_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="8sp" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/week_cell_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:fontFamily="@font/inter_widget" android:id="@+id/week_day_2" android:layout_width="26dp" android:layout_height="26dp" android:gravity="center" android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="1" />
            <TextView android:fontFamily="@font/inter_widget" android:id="@+id/week_dots_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="8sp" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/week_cell_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:fontFamily="@font/inter_widget" android:id="@+id/week_day_3" android:layout_width="26dp" android:layout_height="26dp" android:gravity="center" android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="1" />
            <TextView android:fontFamily="@font/inter_widget" android:id="@+id/week_dots_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="8sp" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/week_cell_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:fontFamily="@font/inter_widget" android:id="@+id/week_day_4" android:layout_width="26dp" android:layout_height="26dp" android:gravity="center" android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="1" />
            <TextView android:fontFamily="@font/inter_widget" android:id="@+id/week_dots_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="8sp" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/week_cell_5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:fontFamily="@font/inter_widget" android:id="@+id/week_day_5" android:layout_width="26dp" android:layout_height="26dp" android:gravity="center" android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="1" />
            <TextView android:fontFamily="@font/inter_widget" android:id="@+id/week_dots_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="8sp" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/week_cell_6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:fontFamily="@font/inter_widget" android:id="@+id/week_day_6" android:layout_width="26dp" android:layout_height="26dp" android:gravity="center" android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="1" />
            <TextView android:fontFamily="@font/inter_widget" android:id="@+id/week_dots_6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="8sp" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
