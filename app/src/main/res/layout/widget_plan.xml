<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="horizontal"
    android:padding="12dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="6dp" android:orientation="vertical">
        <TextView android:id="@+id/pl_weekday" android:fontFamily="@font/inter_widget" android:layout_width="match_parent" android:layout_height="15dp" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/widget_red" android:maxLines="1" />
        <TextView android:id="@+id/pl_day" android:fontFamily="@font/inter_widget" android:layout_width="match_parent" android:layout_height="32dp" android:includeFontPadding="false" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/widget_text" android:maxLines="1" />
        <LinearLayout android:id="@+id/pl_banner_left" android:layout_width="match_parent" android:layout_height="24dp" android:layout_marginTop="2dp" android:orientation="vertical" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="192dp" android:layout_marginTop="2dp">
            <LinearLayout android:id="@+id/pl_hours_left" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" />
            <FrameLayout android:id="@+id/pl_events_left" android:layout_width="match_parent" android:layout_height="match_parent" />
        </FrameLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="6dp" android:orientation="vertical">
        <TextView android:id="@+id/pl_tomorrow" android:fontFamily="@font/inter_widget" android:layout_width="match_parent" android:layout_height="47dp" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/widget_dim" android:text="TOMORROW" android:maxLines="1" />
        <LinearLayout android:id="@+id/pl_banner_right" android:layout_width="match_parent" android:layout_height="24dp" android:layout_marginTop="2dp" android:orientation="vertical" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="192dp" android:layout_marginTop="2dp">
            <LinearLayout android:id="@+id/pl_hours_right" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" />
            <FrameLayout android:id="@+id/pl_events_right" android:layout_width="match_parent" android:layout_height="match_parent" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
