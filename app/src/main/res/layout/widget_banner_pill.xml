<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pill_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="3dp"
    android:background="@drawable/widget_event_bg"
    android:orientation="horizontal">
    <TextView android:id="@+id/pill_title" android:fontFamily="@font/inter_widget" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
