<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">
    <TextView android:fontFamily="@font/inter_widget" android:id="@+id/today_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/widget_accent" android:maxLines="1" android:ellipsize="end" />
    <TextView android:fontFamily="@font/inter_widget" android:id="@+id/today_row_0" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end" />
    <TextView android:fontFamily="@font/inter_widget" android:id="@+id/today_row_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end" />
    <TextView android:fontFamily="@font/inter_widget" android:id="@+id/today_row_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end" />
    <TextView android:fontFamily="@font/inter_widget" android:id="@+id/today_row_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end" />
    <TextView android:fontFamily="@font/inter_widget" android:id="@+id/today_row_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end" />
    <TextView android:fontFamily="@font/inter_widget" android:id="@+id/today_row_5" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
