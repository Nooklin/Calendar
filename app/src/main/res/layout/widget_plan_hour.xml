<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="24dp"
    android:orientation="horizontal">
    <TextView android:id="@+id/ph_label" android:fontFamily="@font/inter_widget" android:layout_width="24dp" android:layout_height="wrap_content" android:includeFontPadding="false" android:textSize="10sp" android:textColor="@color/widget_dim" android:maxLines="1" />
    <LinearLayout android:id="@+id/ph_line" android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:layout_marginTop="5dp" android:background="@color/widget_line" />
</LinearLayout>
