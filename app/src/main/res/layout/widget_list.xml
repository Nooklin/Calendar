<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">
    <LinearLayout android:id="@+id/ls_events" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    <TextView android:id="@+id/ls_empty" android:fontFamily="@font/inter_widget" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No upcoming events" android:textSize="13sp" android:textColor="@color/widget_dim" android:visibility="gone" />
</LinearLayout>
