<?xml version="1.0" encoding="utf-8"?>
<!-- Inter for the widgets: a widget is drawn by the launcher, so it cannot use the font of the app screens. One entry per weight on the weight axis of the variable font. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font android:fontStyle="normal" android:fontWeight="400" android:font="@font/inter" android:fontVariationSettings="'wght' 400" />
    <font android:fontStyle="normal" android:fontWeight="500" android:font="@font/inter" android:fontVariationSettings="'wght' 500" />
    <font android:fontStyle="normal" android:fontWeight="600" android:font="@font/inter" android:fontVariationSettings="'wght' 600" />
    <font android:fontStyle="normal" android:fontWeight="700" android:font="@font/inter" android:fontVariationSettings="'wght' 700" />
</font-family>
